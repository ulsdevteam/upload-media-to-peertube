#--------------------------------------------------------------------
# upload-media-to-peertube config file.
#

#--------------------------------------------------------------------
# python_exe - where is your python executable.
python_exe: /usr/bin/python3

#--------------------------------------------------------------------
# PeerTube Environments
#--------------------------------------------------------------------
environments:
  production:
    peertube_instance: https://peertube.com
    peertube_username: peertube_username
    peertube_password: peertube_password
    peeetube_channel:  peertube_channel

  review:
    peertube_instance: https://peertube-dev.com
    peertube_username: peertube_username
    peertube_password: peertube_password
    peertube_channel:  peertube_channel

#--------------------------------------------------------------------
# Google Sheets Settings
#--------------------------------------------------------------------
# Google Credentials File location:
google_credentials_file: google_creds.json
google_sheet: [google sheet id]
google_sheet_name: Sheet1

#--------------------------------------------------------------------
# Log file
#--------------------------------------------------------------------
log_file: /var/tmp/output.log

#--------------------------------------------------------------------
# Default Thumbnail Files
#--------------------------------------------------------------------
thumbnail_audio: /thumbnails/thumbnail_audio.jpg
thumbnail_video: /thumbnails/thumbnail_video.jpg

#--------------------------------------------------------------------
# id_column - the column name containing object identifiers.
#--------------------------------------------------------------------
id_column: id
